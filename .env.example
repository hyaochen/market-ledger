# market-ledger environment template. Copy to .env and fill in real values.
# Placeholders only; never commit real values. See README "環境變數".

DATABASE_URL=file:./prisma/dev.db
SESSION_SECRET=<at-least-32-random-chars>

TELEGRAM_BOT_TOKEN=<from-botfather>
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
TYPESAFE_API_KEY=<optional>
JEV_TIMEOUT_MS=
CLAUDE_BRIDGE_TOKEN=<random-shared-secret>

POS_IMPORT_TOKEN=<random-token>
POS_SYNC_TOKEN=
POS_TENANT_CODES=<tenant-code>
CASH_SUPERVISOR_NAMES=<tenant-code>=<name>

# Only needed when seeding a fresh volume (production refuses to seed without them)
SUPER_ADMIN_PASSWORD=
ADMIN_PASSWORD=
CASH_ADMIN_PASSWORD=
CASH_EMPLOYEE_PASSWORD=

# Cloudflare tunnel (docker compose fails fast if any is missing)
CLOUDFLARED_DIR=<path-to-.cloudflared>
TUNNEL_ID=<tunnel-uuid>
TUNNEL_HOSTNAME_MAIN=<example.com>
TUNNEL_HOSTNAME_CASH=<cash.example.com>
